<UserControl x:Class="SmartDiagram.App.Pages.ExportPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:SmartDiagram.App.Components">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="278" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="280" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1"
                CornerRadius="6">
            <StackPanel Margin="16">
                <TextBlock Text="预览信息" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,22" />

                <TextBlock Text="文件名" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBox x:Name="PreviewFileNameTextBox" Text="diagram.drawio" />

                <TextBlock Text="图类型" FontWeight="SemiBold" Margin="0,12,0,8" />
                <TextBox x:Name="PreviewDiagramTypeTextBox" Text="功能模块图" />

                <TextBlock Text="页面" FontWeight="SemiBold" Margin="0,12,0,8" />
                <TextBox Text="1" />

                <TextBlock Text="图尺寸" FontWeight="SemiBold" Margin="0,12,0,8" />
                <TextBox Text="自适应画布" />

                <TextBlock Text="节点数量" FontWeight="SemiBold" Margin="0,12,0,8" />
                <TextBox x:Name="PreviewNodeCountTextBox" Text="0" />

                <TextBlock Text="连线数量" FontWeight="SemiBold" Margin="0,12,0,8" />
                <TextBox x:Name="PreviewEdgeCountTextBox" Text="0" />

                <Button Content="⟳  刷新预览" Margin="0,32,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Column="1"
                Margin="8,0,0,0"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1"
                CornerRadius="6">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Width="98" Content="⌖  选择" Margin="0,0,10,0" />
                    <Button Width="98" Content="⊕  缩放" Margin="0,0,10,0" />
                    <Button Width="98" Content="⛶  适配" Margin="0,0,10,0" />
                    <Button Width="98" Content="⇱  导出" Click="ExportButton_Click" />
                </StackPanel>
                <components:DrawioWebPreviewControl x:Name="PreviewHost" Grid.Row="1" />
            </Grid>
        </Border>

        <Border Grid.Column="2"
                Margin="8,0,0,0"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1"
                CornerRadius="6">
            <StackPanel Margin="16">
                <TextBlock Text="导出设置" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,22" />

                <TextBlock Text="格式选择" FontWeight="SemiBold" Margin="0,0,0,8" />
                <Border BorderBrush="{StaticResource PrimaryBlue}" BorderThickness="1" CornerRadius="6" Padding="14,11" Margin="0,0,0,8">
                    <TextBlock Text="▧  draw.io（.drawio）" Foreground="{StaticResource PrimaryBlue}" />
                </Border>
                <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="14,11" Margin="0,0,0,8">
                    <TextBlock Text="▧  SVG（.svg）" />
                </Border>
                <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="14,11" Margin="0,0,0,8">
                    <TextBlock Text="▧  PNG（.png）" />
                </Border>
                <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="14,11" Margin="0,0,0,18">
                    <TextBlock Text="▧  PDF（.pdf）" />
                </Border>

                <TextBlock Text="导出路径" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBox x:Name="ExportPathTextBox" Text="C:\Users\Admin\Documents" />

                <TextBlock Text="文件名" FontWeight="SemiBold" Margin="0,12,0,8" />
                <TextBox x:Name="ExportFileNameTextBox" Text="功能模块图" />

                <TextBlock Text="导出范围" FontWeight="SemiBold" Margin="0,12,0,8" />
                <TextBlock Text="●  整个图      ○  选中内容" Foreground="{StaticResource TextSecondary}" />

                <TextBlock Text="导出选项" FontWeight="SemiBold" Margin="0,18,0,8" />
                <TextBlock Text="☑  包含样式" Margin="0,0,0,8" Foreground="{StaticResource PrimaryBlue}" />
                <TextBlock Text="☑  包含背景" Margin="0,0,0,8" Foreground="{StaticResource PrimaryBlue}" />
                <TextBlock Text="☑  压缩文件" Margin="0,0,0,18" Foreground="{StaticResource PrimaryBlue}" />

                <Button Style="{StaticResource PrimaryButton}" Content="▣  导出" Height="46" Click="ExportButton_Click" />
                <TextBlock x:Name="ExportStatusText"
                           Text="等待导出"
                           Margin="0,12,0,0"
                           Foreground="{StaticResource TextSecondary}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
