<UserControl x:Class="SmartDiagram.App.Pages.EditorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="640"
             MinWidth="980">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="306" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="414" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1"
                CornerRadius="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="14">
                    <TextBlock Text="图类型" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ComboBox SelectedIndex="0">
                        <ComboBoxItem Content="Chen ER 图" />
                    </ComboBox>

                    <Border Height="1" Background="{StaticResource BorderColor}" Margin="0,16,0,12" />

                    <TextBlock Text="输入" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBox Text="教学管理系统的实体关系图，包含院系、学生、教师、课程、成绩、教室等实体及其关系。"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="310"
                             VerticalScrollBarVisibility="Auto" />
                    <TextBlock Text="38/2000" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right" Margin="0,6,0,18" />

                    <TextBlock Text="上传参考图（可选）" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <Button x:Name="UploadButton" Height="94" Click="UploadButton_Click">
                        <StackPanel>
                            <TextBlock Text="⇧  上传图片" HorizontalAlignment="Center" FontWeight="SemiBold" />
                            <TextBlock Text="支持 JPG、PNG（≤5MB）" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Button>

                    <Grid Margin="0,18,0,0">
                        <TextBlock Text="高级选项" FontWeight="SemiBold" />
                        <TextBlock Text="›" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondary}" />
                    </Grid>
                    <Grid Margin="0,18,0,0">
                        <TextBlock Text="识别设置" FontWeight="SemiBold" />
                        <TextBlock Text="自动识别  ›" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondary}" />
                    </Grid>
                    <Grid Margin="0,18,0,0">
                        <TextBlock Text="布局方向" FontWeight="SemiBold" />
                        <TextBlock Text="自动布局  ›" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondary}" />
                    </Grid>

                    <Button Style="{StaticResource PrimaryButton}" Height="46" Margin="0,18,0,0" Content="✦  生成" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Column="1"
                Margin="8,0,0,0"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1"
                CornerRadius="6">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Width="42" Content="⌖" Margin="0,0,10,0" />
                    <Button Width="42" Content="☝" Margin="0,0,10,0" />
                    <Button Width="42" Content="⊕" Margin="0,0,10,0" />
                    <Button Width="42" Content="−" Margin="0,0,10,0" />
                    <Button Width="42" Content="⛶" Margin="0,0,10,0" />
                    <Button Width="42" Content="⤢" />
                </StackPanel>

                <ContentControl x:Name="PreviewHost" Grid.Row="1" />

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button Width="44" Content="▤" />
                    <Button Width="56" Content="−" Margin="10,0,0,0" />
                    <Button Width="88" Content="100%" />
                    <Button Width="56" Content="+" />
                    <Button Width="44" Content="⛶" Margin="10,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="2" Margin="8,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="210" />
                <RowDefinition Height="210" />
            </Grid.RowDefinitions>

            <Border Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button x:Name="JsonButton" Style="{StaticResource GhostButton}" Foreground="{StaticResource PrimaryBlue}" FontWeight="SemiBold" Content="JSON" Click="JsonButton_Click" />
                        <Button Style="{StaticResource GhostButton}" Content="节点" Margin="8,0,0,0" />
                        <Button Style="{StaticResource GhostButton}" Content="连线" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBox x:Name="JsonBox"
                             Grid.Row="1"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="NoWrap"
                             FontFamily="Consolas"
                             FontSize="13"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" />
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Margin="0,8,0,0"
                    Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="节点（7）" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <DataGrid x:Name="NodeGrid" Grid.Row="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="id" Binding="{Binding Id}" />
                            <DataGridTextColumn Header="标签" Binding="{Binding Label}" />
                            <DataGridTextColumn Header="类型" Binding="{Binding Type}" />
                            <DataGridTextColumn Header="形状" Binding="{Binding Shape}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Margin="0,8,0,0"
                    Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="连线（6）" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <DataGrid x:Name="EdgeGrid" Grid.Row="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="id" Binding="{Binding Id}" />
                            <DataGridTextColumn Header="标签" Binding="{Binding Label}" />
                            <DataGridTextColumn Header="起点" Binding="{Binding From}" />
                            <DataGridTextColumn Header="终点" Binding="{Binding To}" />
                            <DataGridTextColumn Header="基数" Binding="{Binding Cardinality}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
