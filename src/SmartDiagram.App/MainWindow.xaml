<Window x:Class="SmartDiagram.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="智能图谱设计器"
        Height="900"
        Width="1280"
        MinHeight="760"
        MinWidth="1100"
        Background="{StaticResource AppBackground}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="72" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True" Margin="22,0">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="22" Height="22" CornerRadius="5" Background="{StaticResource PrimaryBlue}">
                        <TextBlock Text="▣" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" />
                    </Border>
                    <TextBlock Text="智能图谱设计器" FontWeight="SemiBold" FontSize="15" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="24,0" VerticalAlignment="Center">
                <Button Style="{StaticResource GhostButton}" Content="项目" Click="ShowEmpty_Click" />
                <Button Style="{StaticResource GhostButton}" Content="编辑" Margin="8,0,0,0" Click="ShowEditor_Click" />
                <Button Style="{StaticResource GhostButton}" Content="导出" Margin="8,0,0,0" Click="ShowExport_Click" />
                <Button Style="{StaticResource GhostButton}" Content="设置" Margin="8,0,0,0" Click="ShowSettings_Click" />
            </StackPanel>
        </Border>

        <ContentControl x:Name="ContentHost" Grid.Row="2" Margin="14,10,14,10" />

        <Border Grid.Row="3"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="0,1,0,0">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource PrimaryButton}" Width="108" Content="✦  生成" Click="ShowEditor_Click" />
                    <Button Width="154" Content="⇱  导出 draw.io" Margin="12,0,0,0" Click="ShowExport_Click" />
                    <Button Width="142" Content="▣  同步 Visio" Margin="12,0,0,0" Click="ShowVisio_Click" />
                    <Button Width="132" Content="▣  保存版本" Margin="12,0,0,0" Click="ShowVersions_Click" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="版本：v1.0.0" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <Border Width="1" Height="22" Background="{StaticResource BorderColor}" Margin="18,0" />
                    <TextBlock Text="●" Foreground="{StaticResource SuccessGreen}" FontSize="16" VerticalAlignment="Center" />
                    <TextBlock Text=" 已保存" VerticalAlignment="Center" Margin="4,0,18,0" />
                    <Button Width="96" Content="⚙  设置" Click="ShowSettings_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
